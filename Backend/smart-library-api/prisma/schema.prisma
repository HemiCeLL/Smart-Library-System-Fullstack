generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id        Int      @id @default(autoincrement())
  title     String
  author    String
  category  String
  status    String   @default("Tersedia")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("books")
}
